# Copie para .env.local e preencha quando criar o projeto Supabase.
# Use a Project URL e a Publishable key do painel Connect.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Endereço definitivo do site para metadados e validação de origem.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Não é necessária nenhuma chave service_role/secret neste projeto.
